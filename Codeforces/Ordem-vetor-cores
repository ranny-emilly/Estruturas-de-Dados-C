#include <stdio.h>

int main(){
    int n, indices;

    scanf("%d", &n);

    for(int i = 0; i < n; i++){
        scanf("%d", &indices);
        int a[indices];
        int pos[indices];
        for(int j = 0; j < indices; j++){
            scanf("%d", &a[j]);
            pos[j] = j;
           
        }                    
        int copia, copia_pos;
        int troca = 1;
        while(troca){
            troca = 0;
            for(int k = 0; k < indices - 1; k++){
                if(a[k] > a[k+1]) {
                    copia = a[k];
                    a[k] = a[k + 1];
                    a[k + 1] = copia;
                    troca = 1;
                    copia_pos = pos[k];
                    pos[k] = pos[k + 1];
                    pos[k + 1] = copia_pos;

                    troca = 1;
                }
            }
           
        }
        int ok = 1;
        for(int j = 0; j < indices - 1; j++){
            if(pos[j] % 2 == pos[j+1] % 2){
                ok = 0;
                break;
            }
        }

        if(ok) printf("YES\n");
        else printf("NO\n");
    }

    return 0;
}
